PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/danaoresq

# SMS provider: console | semaphore | twilio
SMS_PROVIDER=console

# Semaphore (https://semaphore.co)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=DANAORESQ

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Number residents text/call for SOS from the offline toolkit (your gateway's inbound number or the barangay hotline)
BARANGAY_SOS_NUMBER=
# Map center for the dashboard, "lat,lng" (e.g. the barangay hall). Leave blank to auto-fit markers.
MAP_CENTER=
# Area the maps are limited to, "south,west,north,east". Default: Sibuyan Island, Romblon.
MAP_BOUNDS=12.2672,122.4234,12.5057,122.6987
